# Database Environment Configuration (SQLite or PostgreSQL / Supabase)
# SQLite (Local Dev Fallback):
# DATABASE_URL=sqlite:///./data/university_events.db

# PostgreSQL / Supabase (Cloud & Vercel Production):
# Get connection URL from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Frontend Environment Variable (in frontend/.env or Vercel dashboard)
# VITE_API_BASE_URL=https://your-app.vercel.app

