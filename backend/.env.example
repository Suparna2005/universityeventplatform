# Backend Environment Variables
# For Supabase / PostgreSQL:
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# For Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/university_events

# For Local SQLite Fallback:
# DATABASE_URL=sqlite:///./data/university_events.db

# SMTP email delivery (Gmail requires a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_university_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_university_email@gmail.com
